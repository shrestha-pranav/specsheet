{
  // L1 free preview (product/decisions.md D2, D3.4-D3.7). Agents never run `wrangler login` / `wrangler deploy`: README "Owner deploy steps".
  "name": "specsheet-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Data = the free query pack built by `python3 -I ../scripts/build_r2.py --tier free --shard-hex 3` (gitignored, one release per
  // Worker version). run_worker_first: every request runs the Worker (quota, breaker, metrics); pack files are read only via ASSETS.
  // No R2 binding at L1.
  "assets": { "directory": "./pack", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none", "not_found_handling": "none" },
  "durable_objects": { "bindings": [ { "name": "BUDGET", "class_name": "Budget" }, { "name": "BREAKER", "class_name": "Breaker" } ] },
  "migrations": [ { "tag": "v1", "new_sqlite_classes": ["Budget", "Breaker"] } ],
  // 60 requests / 60 s per client key (IPv4 /32, IPv6 /64). namespace_id is any account-unique integer string.
  "ratelimits": [ { "name": "RATE_LIMITER", "namespace_id": "4151", "simple": { "limit": 60, "period": 60 } } ],
  "analytics_engine_datasets": [ { "binding": "METRICS", "dataset": "specsheet_requests" } ],
  "observability": { "enabled": false },
  "vars": {
    // PAYMENTS: "off" (L1, committed default) | "on" (L2 only, after legal review; needs PAY_TO secret and a valid x402 config).
    "PAYMENTS": "off",
    // PREVIEW: "on" | "off" (manual kill switch: every data route answers 503 preview_paused).
    "PREVIEW": "on",
    // Global daily data-route requests before 503 preview_capacity (60% of the Workers Free 100k/day).
    "BREAKER_DAILY": "45000",
    // The only origin allowed to POST /v1/miss and /v1/event (CORS), and the Pages site named in discovery text.
    "SITE_ORIGIN": "https://shrestha-pranav.github.io",
    "STATIC_ORIGIN": "https://shrestha-pranav.github.io/specsheet",
    // PAYMENTS=on only: x402 network (CAIP-2), Base Sepolia testnet by default. Mainnet also needs ALLOW_MAINNET and a mainnet FACILITATOR_URL.
    "X402_NETWORK": "eip155:84532",
    "FACILITATOR_URL": "https://x402.org/facilitator",
    "ALLOW_MAINNET": "false"
    // PAY_TO is a secret (`wrangler secret put PAY_TO`), intentionally absent; with PAYMENTS=off it is never read.
  }
}
