# Copy to .dev.vars (gitignored). Placeholders only - never commit real values. Defaults live in wrangler.jsonc.
# Local paid-mode experiments only (L2): PAYMENTS=on plus a Base Sepolia receiving address.
# PAYMENTS=on
# PAY_TO=0xYOUR_TESTNET_RECEIVING_ADDRESS
# X402_NETWORK=eip155:84532
# FACILITATOR_URL=https://x402.org/facilitator
# Mainnet only, with X402_NETWORK=eip155:8453 and a mainnet FACILITATOR_URL:
# ALLOW_MAINNET=true
# CDP_API_KEY_ID=placeholder
# CDP_API_KEY_SECRET=placeholder
