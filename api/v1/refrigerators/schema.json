 "conditions": [
  {
   "id": "test_procedure",
   "label": "DOE test procedure",
   "type": "enum",
   "enum": [
    "appendix_a",
    "appendix_a1",
    "appendix_b",
    "maker_unstated"
   ],
   "description": "Basis of a volume or kWh figure. Current US refrigerator-freezer figures are 10 CFR 430 Subpart B Appendix A (freezers: Appendix B); pre-2014 filings used Appendix A1 with a different adjusted-volume factor and kWh basis, so pre-2014 figures do not compare. ES p5st-her9 rows are current-procedure by construction (active specification); a maker spec sheet states no procedure = maker_unstated."
  },
  {
   "id": "depth_basis",
   "label": "Depth measured to",
   "type": "enum",
   "enum": [
    "case",
    "doors",
    "handles",
    "doors_open_90",
    "unstated"
   ],
   "description": "Fridge depth is printed four ways and they differ by 2-5 in: cabinet only, to the door face, to the handle tips, and installation depth with doors open 90 deg. A depth without its basis is maker-stated, unstated basis."
  },
  {
   "id": "noise_basis",
   "label": "Noise basis",
   "type": "enum",
   "enum": [
    "maker_dba_unstated_method",
    "sound_power_db_re_1pw",
    "sound_pressure_dba"
   ],
   "description": "US maker pages print \"dBA\" with no method; EU energy labels give sound POWER dB(A) re 1 pW (IEC 60704), which reads several dB higher than a sound-pressure figure for the same unit. Never compare across bases."
  }
 ],
