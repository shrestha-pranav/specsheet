  {
   "id": "test_procedure",
   "label": "DOE test procedure",
   "type": "enum",
   "enum": [
    "appendix_d2",
    "appendix_d1",
    "maker_unstated"
   ],
   "description": "Basis of CEF, drum capacity, test-cycle time and annual kWh. ES t9u7-4d2j cites 10 CFR 430 Subpart B Appendix D2 (automatic termination, over-drying counted; 283 cycles/yr). Appendix D1 (the federal-standard procedure many DOE CCD filings use) credits drying differently and typically gives a HIGHER CEF for the same dryer: D1 and D2 figures are never compared."
  }
 ],
