 "conditions": [
  {
   "id": "power_basis",
   "label": "Power basis",
   "type": "enum",
   "enum": [
    "energy_star_on_mode",
    "doe_federal_test",
    "energy_star_standby",
    "maker_typical",
    "maker_unstated"
   ],
   "description": "Which test/declaration a power figure is: ENERGY STAR on-mode test (default picture, ABC as shipped), the DOE federal test procedure figure reported with it, the maker's \"Typical\", or a maker figure with no stated basis. Different bases are never one assertion."
  },
  {
   "id": "standby_network",
   "label": "Standby network state",
   "type": "enum",
   "enum": [
    "connected",
    "not_connected"
   ],
   "description": "ENERGY STAR reports standby with and without a network connection; both are true of the same TV."
  },
  {
   "id": "brightness_basis",
   "label": "Brightness basis",
   "type": "enum",
   "enum": [
    "uhda_typical",
    "maker_peak_unstated"
   ],
   "description": "TCL prints peak brightness per the UHD Alliance test method (typical) in some boxes and a marketing \"up to\" peak in others."
  }
 ],
