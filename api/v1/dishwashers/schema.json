 "conditions": [
  {
   "id": "test_procedure",
   "label": "DOE test procedure",
   "type": "enum",
   "enum": [
    "appendix_c1",
    "appendix_c2",
    "maker_unstated"
   ],
   "description": "Basis of kWh/yr and gal/cycle. Current filings use 10 CFR 430 Subpart B Appendix C1 (normal cycle, soil-sensing average, 215 cycles/yr). DOE's newer Appendix C2 (adopted with the amended standards; to verify the mandatory date before an adapter tags it) changes cycle/soil definitions, so C1 and C2 figures are not comparable. ES active rows = the procedure of the active specification."
  },
  {
   "id": "noise_basis",
   "label": "Noise basis",
   "type": "enum",
   "enum": [
    "maker_dba_unstated_method",
    "sound_power_db_re_1pw"
   ],
   "description": "US makers print \"dBA\" without method (in practice a sound-power-style rating on the normal or quietest cycle, varies by maker); EU label figures are sound power dB(A) re 1 pW. Cycle is rarely stated. Not comparable across makers with confidence."
  },
  {
   "id": "noise_cycle",
   "label": "Cycle measured",
   "type": "enum",
   "enum": [
    "normal",
    "quietest",
    "unstated"
   ],
   "description": "Which wash cycle a noise figure is for; \"Quiet/Silence\" cycles can be 2-4 dB lower than Normal."
  }
 ],
