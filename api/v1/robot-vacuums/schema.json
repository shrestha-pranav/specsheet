 "conditions": [
  {
   "id": "claim_basis",
   "label": "Claim basis (how the figure was obtained)",
   "type": "enum",
   "enum": [
    "mfr_in_house_lab",
    "mfr_unstated",
    "mfr_reported_certified",
    "third_party_certified",
    "independent_measured"
   ],
   "description": "mfr_in_house_lab = page disclaimer says \"based on our in-house lab data\"; mfr_unstated = no basis printed (also: a disclaimer that names a lab or certifier without an affirmative statement, or a negated one such as \"not certified by SGS\"); mfr_reported_certified = the manufacturer's disclaimer affirmatively attributes THIS figure to TUV/SGS/Intertek/UL (\"certified by ...\": a manufacturer statement, certificate not checked here, review 3); third_party_certified = a certifier-tier source we read ourselves; independent_measured = a non-manufacturer test (sealed-inlet suction, dB at a stated distance). Claim bases are not comparison methods: two figures on different bases never form a ranking cohort."
  },
  {
   "id": "power_mode",
   "label": "Operating mode",
   "type": "enum",
   "enum": [
    "quiet",
