 "conditions": [
  {
   "id": "cct_k",
   "label": "Measured at colour temperature",
   "type": "number",
   "unit": "K",
   "description": "The correlated colour temperature the lumen figure was measured / rated at. A tunable bulb gives different lumens at 2700 K and 6500 K (often 20-40% apart), so a lumen figure without its CCT is not comparable to one with it. ENERGY STAR lamp filings state the CCT of the tested setting (light_appearance_kelvin). A basis condition: two figures at different CCTs are alternatives, never merged."
  },
  {
   "id": "lumens_basis",
   "label": "Lumen figure basis",
   "type": "enum",
   "enum": [
    "certified_lm79",
    "maker_max",
    "maker_rated",
    "maker_up_to"
   ],
   "description": "certified_lm79 = ENERGY STAR / regulator filed output (IES LM-79 test); maker_max = maker prints \"max lumen output\"; maker_rated = maker prints the nominal output without qualifier; maker_up_to = \"up to N lumens\" marketing qualifier (shown, never a preset gate)."
  }
 ],
