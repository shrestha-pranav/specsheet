 "conditions": [
  {
   "id": "retention_pct",
   "label": "Capacity retained at end of rated cycles",
   "type": "number",
   "unit": "%",
   "description": "Basis of bat.cycle_life: 4000 cycles to 80 % and 4000 cycles to 70 % are different claims (Jackery prints 70 %)."
  },
  {
   "id": "charge_to_pct",
   "label": "Charged to",
   "type": "number",
   "unit": "%",
   "description": "Basis of recharge times: 0-80 % vs 0-100 %. A time without it is an unresolved preview claim."
  },
  {
   "id": "charger",
   "label": "Charger / input used",
   "type": "text",
   "description": "The printed charger or input the time was quoted with (AC Fast Charge, 600W Power Supply)."
  },
  {
   "id": "backup_mode",
   "label": "Backup mode",
   "type": "enum",
   "enum": [
    "ups",
    "eps",
    "aps"
   ],
   "description": "Maker term for the switchover: UPS (online/near-zero), EPS (emergency), Goal Zero APS. Basis of ups.switchover_ms."
  },
  {
   "id": "voltage_basis",
   "label": "Solar voltage basis",
   "type": "enum",
   "enum": [
    "voc",
    "operating",
    "unstated"
   ],
   "description": "Whether the window is open-circuit voltage (Voc), the MPPT operating range, or not stated."
  },
  {
   "id": "port",
   "label": "Input port",
   "type": "text",
   "description": "The solar input a window or figure belongs to when a station has several (8mm vs HPP, High-PV vs Low-PV)."
  },
  {
   "id": "ac_charge_mode",
   "label": "AC charge mode",
   "type": "text",
   "description": "Turbo / ultra fast / standard / low speed AC charging; figures under different modes are not one headline."
  },
  {
   "id": "extra_batteries",
   "label": "Extra batteries attached",
   "type": "number",
   "description": "Number of extra batteries an expanded capacity is quoted with."
  },
  {
   "id": "idle_mode",
   "label": "Idle state",
   "type": "enum",
   "enum": [
    "ac_on",
    "standby",
    "unstated"
   ],
   "description": "What is switched on while the idle draw is measured."
  }
 ],
