 "conditions": [
  {
   "id": "cadr_basis",
   "label": "CADR basis",
   "type": "enum",
   "enum": [
    "energy_star_certified",
    "aham_verified_maker_stated",
    "maker_claimed"
   ],
   "description": "Who stands behind a CADR: the ENERGY STAR filing (reported to EPA through a recognised certification body, AHAM AC-1 test), a maker page that affirmatively says the figure is AHAM Verifide, or a maker figure with no stated verification. The AHAM Verifide directory itself was not reachable (merchants.md); \"aham_verified_maker_stated\" is the maker's claim, not a checked listing."
  },
  {
   "id": "room_basis",
   "label": "Room size basis",
   "type": "enum",
   "enum": [
    "energy_star_formula",
    "aham_verified_maker_stated",
    "maker_stated_ach"
   ],
   "description": "ENERGY STAR room size = smoke CADR x 1.55 (the AHAM formula, ~4.8 air changes/h at 8 ft); a maker \"AHAM Verified Room Size\"; or a maker figure at a stated air-change rate."
  },
  {
   "id": "ach",
   "label": "Air changes per hour",
   "type": "number",
   "unit": null,
   "description": "Air-change rate the maker states for a room-size figure."
  },
  {
   "id": "fan_speed",
   "label": "Fan speed",
   "type": "enum",
   "enum": [
    "lowest",
    "highest",
    "sleep",
    "low",
    "medium",
    "high",
    "turbo",
    "range_min",
    "range_max"
   ],
   "description": "Speed a noise/power figure is for. range_min / range_max = the ends of a printed range (\"22-52 dB\") whose speeds are not named. Distance and weighting are almost never stated (kept in raw)."
  },
  {
   "id": "power_basis",
   "label": "Power basis",
   "type": "enum",
   "enum": [
    "maker_rated",
    "maker_unstated",
    "energy_star_16h_active"
   ],
   "description": "Nameplate/rated input power vs an unlabelled maker figure vs the ENERGY STAR annual figure (16 h/day active)."
  },
  {
   "id": "filter_stage",
   "label": "Filter stage",
   "type": "enum",
   "enum": [
    "hepa",
    "carbon",
    "pre_filter",
    "set",
    "composite",
    "washable",
    "non_woven",
    "other"
   ],
   "description": "Which filter a type / life / part number / price belongs to; \"set\" = a combined replacement kit."
  },
  {
   "id": "price_basis",
   "label": "Price basis",
   "type": "enum",
   "enum": [
    "displayed",
    "list",
    "sale"
   ],
   "description": "Which price a dated filter price is."
  }
 ],
