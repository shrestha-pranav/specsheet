{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specsheet.invalid/schemas/public-detail/1",
  "title": "Published detail record (docs/api/v1/<cat>/products/<id>.json and preview/<cat>/products/<id>.json)",
  "description": "Public projection of an accepted record (record.schema.json): no claims[], no snapshots/locators; specs are resolved values. review_scope=trusted holds accepted claims + approved relations only; review_scope=preview is a delta (specs that differ from the trusted record) incl. candidates and proposed relations.",
  "type": "object",
  "required": [
    "record_format",
    "review_scope",
    "id",
    "category",
    "kind",
    "brand",
    "name",
    "identifiers",
    "relations",
    "specs",
    "sources"
  ],
  "properties": {
    "record_format": {
      "const": "specsheet.record/1"
    },
    "review_scope": {
      "enum": [
        "trusted",
        "preview"
      ]
    },
    "id": {
      "$ref": "https://specsheet.invalid/schemas/record/1#/$defs/entityId"
    },
    "category": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "family",
        "model",
        "configuration",
        "package",
        "revision"
      ]
    },
    "brand": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "name": {
      "type": "string"
    },
    "variant_label": {
      "type": [
        "string",
        "null"
      ]
    },
    "lifecycle": {
      "type": "object"
    },
    "identifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scheme",
          "value",
          "role"
        ],
        "properties": {
          "scheme": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "role": {
            "enum": [
              "key",
              "alias"
            ]
          }
        }
      }
    },
    "aliases": {
      "type": "array"
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "target",
          "status",
          "method"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "status": {
            "enum": [
              "approved",
              "proposed"
            ]
          },
          "method": {
            "type": "string"
          },
          "decision": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "specs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "https://specsheet.invalid/schemas/record/1#/$defs/resolved"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "url"
        ],
        "properties": {
          "id": {
            "$ref": "https://specsheet.invalid/schemas/record/1#/$defs/sourceRef"
          },
          "url": {
            "type": "string"
          },
          "via": {
            "type": "string",
            "description": "Ancestor entity whose source this is (inherited specs)."
          },
          "licence_grant": {
            "type": "boolean",
            "description": "data/source-policy.yaml: values citing this source are under our ODbL grant (true) or shown as facts with a link only (false)."
          },
          "evidence": {
            "type": "string",
            "pattern": "^https://",
            "description": "Corrections flow (D9.2): the GitHub issue (or proposal file) whose reviewed evidence cites this page (E2 maker page, E3 measurement)."
          },
          "relicense": {
            "const": false,
            "description": "Crowd/correction-sourced values are excluded from any future alternative licence until the relicensing clause clears counsel (D9.2, Q1)."
          }
        },
        "not": {
          "required": [
            "snapshot"
          ]
        }
      }
    },
    "children": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trusted": {
      "type": "boolean"
    },
    "family": {
      "type": [
        "string",
        "null"
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "variant": {
      "type": [
        "string",
        "null"
      ]
    },
    "demo": {
      "const": false
    },
    "revisions": {
      "type": "array",
      "description": "Model detail only: hardware revisions (kind=revision children). Each entry carries the revision's OWN specs (not inherited ones), the sources they cite, and `differs` = own spec keys whose value differs from (or is absent on) the model. Full record: products/<id>.json.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "name",
          "specs",
          "sources",
          "differs"
        ],
        "properties": {
          "id": {
            "$ref": "https://specsheet.invalid/schemas/record/1#/$defs/entityId"
          },
          "label": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "lifecycle": {
            "type": "object"
          },
          "specs": {
            "type": "object",
            "additionalProperties": {
              "$ref": "https://specsheet.invalid/schemas/record/1#/$defs/resolved"
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "url"
              ]
            }
          },
          "differs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "contents": {
      "type": "array",
      "description": "package kind only: what the bundle contains (record.schema.json contents). `entity` = a published model id, `description` = a component the catalogue does not hold (solar panel, accessory kit).",
      "items": {
        "type": "object",
        "required": [
          "qty"
        ],
        "properties": {
          "entity": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "qty": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "bundles": {
      "type": "array",
      "description": "Model detail only (r6): bundle packages that contain this model ('Sold as bundles'). Each is also a detail file products/<id>.json (kind=package, no specs). qty = units of THIS model in the bundle.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "sku",
          "qty",
          "contents"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "sku": {
            "type": [
              "string",
              "null"
            ]
          },
          "qty": {
            "type": "integer",
            "minimum": 1
          },
          "contents": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "qty"
              ],
              "properties": {
                "entity": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "qty": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    },
    "bundle_evidence": {
      "type": "object",
      "description": "Package kind only (r7, scripts/bundles.py bundles@2): evidence level of the contents. evidence = manufacturer_store_listing (one listing) | consistent_manufacturer_store_listings (several agree: consistency, not independent corroboration); complete=false when part of the listing is not itemised (unparsed); promotions = free items seen with the SKU, dated, never contents.",
      "properties": {
        "evidence": {
          "enum": [
            "manufacturer_store_listing",
            "consistent_manufacturer_store_listings"
          ]
        },
        "observations": {
          "type": "integer",
          "minimum": 1
        },
        "complete": {
          "type": "boolean"
        },
        "unparsed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "promotions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "observed_at": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "market": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_from": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_to": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "certifications": {
      "type": "array",
      "description": "Model detail (r7, scripts/tvcert.py): directed covered_by_certification edges to ENERGY STAR wildcard family records. Coverage, not identity: no merge, no inheritance. Only certification (pwr.energy_star, dated) transfers over an approved edge; `power` is the record's own figures and transfers only when power_transferred. Trusted details list approved edges; previews also list proposals.",
      "items": {
        "type": "object",
        "required": [
          "record",
          "pattern",
          "method",
          "status"
        ],
        "properties": {
          "record": {
            "type": "string"
          },
          "pattern": {
            "type": "string"
          },
          "matched_pattern": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "enum": [
              "basic",
              "declared",
              "listed",
              "declaration_not_exact"
            ]
          },
          "market": {
            "type": [
              "string",
              "null"
            ]
          },
          "declaration": {
            "type": [
              "string",
              "null"
            ]
          },
          "date_qualified": {
            "type": [
              "string",
              "null"
            ]
          },
          "method": {
            "type": "string"
          },
          "status": {
            "enum": [
              "approved",
              "proposed"
            ]
          },
          "decision": {
            "type": [
              "string",
              "null"
            ]
          },
          "power_transferred": {
            "type": "boolean"
          },
          "power": {
            "type": "array"
          }
        }
      }
    },
    "same_hardware": {
      "type": "array",
      "description": "r8 (scripts/xwalk.py): an ENERGY STAR declared_same_hardware alias that is also another entity's model key. The two stay separate entities (no merge, ids kept); role=declared_alias on the alias entity (target = certified base), role=certified_base on the base (alias_id). Over an approved edge only certification keys transfer (`transferred`). Trusted details list approved edges; previews also list proposals.",
      "items": {
        "type": "object",
        "required": [
          "relation",
          "role",
          "alias",
          "method",
          "status"
        ],
        "properties": {
          "relation": {
            "const": "same_hardware_as"
          },
          "role": {
            "enum": [
              "declared_alias",
              "certified_base"
            ]
          },
          "alias": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "alias_id": {
            "type": "string"
          },
          "record": {
            "type": "string"
          },
          "declaration": {
            "type": "string"
          },
          "date_certified": {
            "type": [
              "string",
              "null"
            ]
          },
          "method": {
            "type": "string"
          },
          "status": {
            "enum": [
              "approved",
              "proposed"
            ]
          },
          "decision": {
            "type": [
              "string",
              "null"
            ]
          },
          "transferred": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "index_scope": {
      "enum": [
        "certification_only"
      ],
      "description": "r8: present when the trusted record holds only certification / regulatory metadata (profile index_rows): the entity is in lookup and products/ and in <cat>/index-certonly*.json, not in the default index shards."
    },
    "corrections_pending": {
      "type": "array",
      "description": "PREVIEW ONLY (D9.2): open, unreviewed corrections. They publish no value, only the notice 'A correction is under review'. Trusted files never carry this field.",
      "items": {"type": "object", "required": ["key", "ref"], "properties": {"key": {"type": "string"}, "ref": {"type": "string"}}}
    }
  },
  "if": {"properties": {"review_scope": {"const": "trusted"}}},
  "then": {"not": {"required": ["corrections_pending"]}}
}
