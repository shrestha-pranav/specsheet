{
  "_note": "Killer-query presets (team/briefs/pm-2026-11-24-killer-queries-a4.md). Source file: scripts/presets.py reads it at build time, measures the real fill of each preset's keys in the published index, and writes docs/api/v1/presets.json (what the app and agents read). Never hand-edit fill numbers; there are none here. filters use the app's own URL keys f_<field>_(min|max|value). gate keys = filter keys + require. min_fill defaults to 0.8.",
  "default_min_fill": 0.8,
  "renderers": {
    "pdo_pill": {"label": "Samsung 45 W", "categories": ["power-banks", "chargers"], "min_amps": 4.5, "v_lo": 9, "v_hi": 11,
      "rule": "yes when an output port lists a PPS range covering 9 to 11 V at 4.5 A or more; no when every output port lists its PPS (or the product states no PPS) and none qualifies; otherwise unknown"},
    "size_grid": {"categories": ["tvs"], "size_key": "gen.size_class", "panel_keys": ["panel.display_tech", "panel.lcd_type", "panel.oled_subtype"], "zone_key": "hdr.dimming_zones", "hdmi_key": "hdmi.ports_4k120"}
  },
  "presets": [
    {"id": "ram-upgradable", "category": "laptops", "title": "Laptops with upgradable RAM, 32 GB+ possible, 14 inch, under 1.4 kg",
      "filters": {"f_mem.soldered_value": "socketed", "f_mem.max_min": "32", "f_disp.size_min": "13.9", "f_disp.size_max": "14.2", "f_phys.weight_max": "1.4"},
      "columns": ["cpu.model", "mem.size", "mem.soldered", "mem.max", "disp.size", "phys.weight"], "sort": {"key": "phys.weight", "dir": "asc"}},
    {"id": "no-pwm-usbc-monitor", "category": "monitors", "title": "Monitors 27 inch and up with no PWM flicker and USB-C power delivery of 65 W+",
      "filters": {"f_flk.pwm_value": "none", "f_usb.usbc_pd_w_min": "65", "f_gen.size_class_min": "27"},
      "columns": ["gen.size_class", "panel.technology", "res.native", "flk.pwm", "usb.usbc_pd_w"], "sort": {"key": "usb.usbc_pd_w", "dir": "desc"}},
    {"id": "ssd-dram-tlc-2tb", "category": "ssds", "title": "2 TB NVMe SSDs with real DRAM (not HMB) and TLC flash",
      "filters": {"f_gen.capacity_min": "1900", "f_gen.capacity_max": "2100", "f_if.protocol_value": "nvme", "f_hw.dram_type_value": "dram", "f_hw.nand_type_value": "tlc"},
      "columns": ["gen.capacity", "hw.dram_type", "hw.nand_type", "if.pcie_gen", "perf.seq_read", "end.tbw"], "sort": {"key": "perf.seq_read", "dir": "desc"}},
    {"id": "power-bank-samsung-45w", "category": "power-banks", "title": "Power banks with PPS and a 45 W+ port (open one for the Samsung 45 W check)",
      "filters": {"f_pd.pps_value": "yes", "f_out.max_single_port_w_min": "45"},
      "columns": ["cap.energy_wh", "out.max_single_port_w", "pd.pps", "out.max_total_w"], "sort": {"key": "out.max_single_port_w", "dir": "desc"}},
    {"id": "tv-panel-by-size", "category": "tvs", "title": "What panel does each TV size use?",
      "filters": {}, "require": ["gen.size_class", "panel.display_tech"], "view": "sizegrid",
      "columns": ["gen.size_class", "panel.display_tech", "hdr.dimming_zones", "hdmi.ports_4k120"], "sort": {"key": "gen.size_class", "dir": "asc"}},
    {"id": "tv-4-hdmi-4k120", "category": "tvs", "title": "TVs with 4 or more HDMI ports that take 4K at 120 Hz",
      "filters": {"f_hdmi.ports_4k120_min": "4"},
      "columns": ["gen.size_class", "panel.display_tech", "hdmi.ports_4k120", "refresh.native_hz"], "sort": {"key": "gen.size_class", "dir": "asc"}},
    {"id": "router-4x4-5-6ghz", "category": "routers", "title": "Routers with 4x4 on 5 GHz that also have 6 GHz (6 GHz stream count is the missing field)",
      "filters": {"f_wifi.streams_5_value": "4", "f_wifi.has_6ghz_value": "yes"}, "require": ["wifi.streams_6"],
      "columns": ["wifi.generation", "wifi.band_count", "wifi.has_6ghz", "wifi.streams_5", "wifi.streams_6"], "sort": {"key": "wifi.streams_6", "dir": "desc"}},
    {"id": "purifier-400sqft-smoke", "category": "air-purifiers", "title": "Purifiers for 400 sq ft, ranked by smoke CADR (needs filter prices for per-dollar)",
      "filters": {"f_room.size_sqft_min": "400"}, "require": ["cadr.smoke_cfm", "filter.price_usd"],
      "columns": ["cadr.smoke_cfm", "room.size_sqft", "filter.true_hepa", "noise.db"], "sort": {"key": "cadr.smoke_cfm", "dir": "desc"}}
  ]
}
